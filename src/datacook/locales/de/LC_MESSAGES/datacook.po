msgstr "Werte klassieren"

#: datacook/engine/ops/stats.py:296
msgid ""
"Put numbers into intervals: a number of equal-width bins, or bins between "
"given edges (histogram classes)."
msgstr ""
"Zahlen in Intervalle einteilen: eine Anzahl gleich breiter Klassen oder "
"Klassen zwischen gegebenen Grenzen (Histogrammklassen)."

#: datacook/engine/ops/stats.py:311
msgid "Bins"
msgstr "Klassen"

#: datacook/engine/ops/stats.py:312
msgid "A number of equal-width bins, or the bin edges (ascending)."
msgstr ""
"Eine Anzahl gleich breiter Klassen oder die Klassengrenzen (aufsteigend)."

#: datacook/engine/ops/stats.py:314
msgid "Bins include their right edge"
msgstr "Klassen beinhalten ihren rechten Rand"

#: datacook/engine/ops/stats.py:315
msgid "First bin includes its left edge"
msgstr "Erste Klasse beinhaltet ihren linken Rand"

#: datacook/engine/ops/stats.py:317
msgid "Labels"
msgstr "Beschriftungen"

#: datacook/engine/ops/stats.py:317
msgid "One per bin; empty: the intervals."
msgstr "Eine pro Klasse; leer: die Intervalle."

#: datacook/engine/ops/stats.py:319
msgid "Precision of the interval labels"
msgstr "Genauigkeit der Intervallbeschriftungen"

#: datacook/engine/ops/strings.py:32
msgid "Change case"
msgstr "Groß- / Kleinschreibung ändern"

#: datacook/engine/ops/strings.py:33
msgid "Upper case, lower case, capitalize, title case, ... of text columns."
msgstr ""
"Großbuchstaben, Kleinbuchstaben, erster Buchstabe groß, ... in Textspalten."

#: datacook/engine/ops/strings.py:39
msgid "Case"
msgstr "Schreibweise"

#: datacook/engine/ops/strings.py:45
msgid "Strip text"
msgstr "Text trimmen"

#: datacook/engine/ops/strings.py:46
msgid ""
"Remove whitespace (or the given characters) at the start and end of text."
msgstr ""
"Leerraum (oder die angegebenen Zeichen) am Anfang und Ende von Texten "
"entfernen."

#: datacook/engine/ops/strings.py:52 datacook/engine/ops/strings.py:105
msgid "Side"
msgstr "Seite"

#: datacook/engine/ops/strings.py:55
msgid "Characters"
msgstr "Zeichen"

#: datacook/engine/ops/strings.py:56
msgid "Characters to remove (any order). Empty: whitespace."
msgstr "Zu entfernende Zeichen (beliebige Reihenfolge). Leer: Leerraum."

#: datacook/engine/ops/strings.py:62
msgid "Replace text"
msgstr "Text ersetzen"

#: datacook/engine/ops/strings.py:63
msgid "Replace a text or a regular expression in text columns."
msgstr "Einen Text oder regulären Ausdruck in Textspalten ersetzen."

#: datacook/engine/ops/strings.py:69
msgid "Search for"
msgstr "Suchen nach"

#: datacook/engine/ops/strings.py:70
msgid "Replace with"
msgstr "Ersetzen durch"

#: datacook/engine/ops/strings.py:73 datacook/engine/ops/strings.py:147
#: datacook/engine/ops/strings.py:355 datacook/engine/ops/strings.py:388
msgid "Regular expression"
msgstr "Regulärer Ausdruck"

#: datacook/engine/ops/strings.py:74
msgid "Groups can be used in the replacement as \\1, \\2, ..."
msgstr "Gruppen können im Ersatz als \\1, \\2, ... verwendet werden"

#: datacook/engine/ops/strings.py:76 datacook/engine/ops/strings.py:144
msgid "Case sensitive"
msgstr "Groß- / Kleinschreibung beachten"

#: datacook/engine/ops/strings.py:77 datacook/engine/ops/strings.py:387
msgid "-1: all"
msgstr "-1: alle"

#: datacook/engine/ops/strings.py:77
msgid "Replacements per cell"
msgstr "Ersetzungen pro Zelle"

#: datacook/engine/ops/strings.py:82
msgid "Slice text"
msgstr "Textausschnitt"

#: datacook/engine/ops/strings.py:84
msgid ""
"Keep the characters from start to stop (Python slice, negative = from the "
"end)."
msgstr ""
"Die Zeichen von Start bis Ende behalten (Python-Slice, negativ = vom Ende)."

#: datacook/engine/ops/strings.py:97
msgid "Pad text"
msgstr "Text auffüllen"

#: datacook/engine/ops/strings.py:98
msgid "Fill text up to a minimum width (e.g. leading zeros)."
msgstr "Text bis zu einer Mindestbreite auffüllen (z. B. führende Nullen)."

#: datacook/engine/ops/strings.py:104
msgid "Width"
msgstr "Breite"

#: datacook/engine/ops/strings.py:106
msgid "Fill character"
msgstr "Füllzeichen"

#: datacook/engine/ops/strings.py:111
msgid "Text length"
msgstr "Textlänge"

#: datacook/engine/ops/strings.py:112
msgid "Number of characters of each text."
msgstr "Anzahl der Zeichen jedes Textes."

#: datacook/engine/ops/strings.py:126
msgid "Repeat text"
msgstr "Text wiederholen"

#: datacook/engine/ops/strings.py:127
msgid "Repeat each text n times."
msgstr "Jeden Text n-mal wiederholen."

#: datacook/engine/ops/strings.py:133
msgid "Repeats"
msgstr "Wiederholungen"

#: datacook/engine/ops/strings.py:142
msgid "Test"
msgstr "Prüfung"

#: datacook/engine/ops/strings.py:143
msgid "Pattern"
msgstr "Muster"

#: datacook/engine/ops/strings.py:148
msgid "Only for 'contains'; 'match' and 'fullmatch' always use one."
msgstr "Nur für 'contains'; 'match' und 'fullmatch' verwenden immer einen."

#: datacook/engine/ops/strings.py:171
msgid "Test text"
msgstr "Text prüfen"

#: datacook/engine/ops/strings.py:172
msgid ""
"True / False per cell: contains, starts with, ends with or matches a pattern."
msgstr ""
"Wahr / Falsch pro Zelle: enthält, beginnt mit, endet mit oder passt auf ein "
"Muster."

#: datacook/engine/ops/strings.py:187
msgid "Filter rows by text"
msgstr "Zeilen nach Text filtern"

#: datacook/engine/ops/strings.py:188
msgid "Keep the rows whose text contains, starts with, ... a pattern."
msgstr "Die Zeilen behalten, deren Text ein Muster enthält, damit beginnt, ..."

#: datacook/engine/ops/strings.py:344
msgid "Extract with regular expression"
msgstr "Mit regulärem Ausdruck extrahieren"

#: datacook/engine/ops/strings.py:346
msgid ""
"New columns from the groups of a regular expression; named groups (?"
"P<name>...) name the columns."
msgstr ""
"Neue Spalten aus den Gruppen eines regulären Ausdrucks; benannte Gruppen (?"
"P<name>...) benennen die Spalten."

#: datacook/engine/ops/strings.py:359 datacook/engine/ops/strings.py:391
msgid "Prefix of the new columns"
msgstr "Präfix der neuen Spalten"

#: datacook/engine/ops/strings.py:360 datacook/engine/ops/strings.py:393
msgid "Default: the column name and '_'."
msgstr "Standard: der Spaltenname und '_'."

#: datacook/engine/ops/strings.py:379
msgid "Split text into columns"
msgstr "Text in Spalten aufteilen"

#: datacook/engine/ops/strings.py:380
msgid "Split text at a separator into new columns."
msgstr "Text an einem Trennzeichen in neue Spalten aufteilen."

#: datacook/engine/ops/strings.py:386
msgid "Empty: whitespace."
msgstr "Leer: Leerraum."

#: datacook/engine/ops/strings.py:387
msgid "Maximum splits"
msgstr "Maximale Anzahl Teilungen"

#: datacook/engine/ops/timeseries.py:30
msgid "Time column"
msgstr "Zeitspalte"

#: datacook/engine/ops/timeseries.py:41
msgid "Use as time column"
msgstr "Als Zeitspalte verwenden"

#: datacook/engine/ops/timeseries.py:43
msgid ""
"Make a date / time (or numeric) column the time of the table: rows are "
"sorted by it and time series steps use it by default."
msgstr ""
"Eine Datums- / Zeitspalte (oder numerische Spalte) zur Zeit der Tabelle "
"machen: die Zeilen werden danach sortiert und Zeitreihen-Schritte verwenden "
"sie standardmäßig."

#: datacook/engine/ops/timeseries.py:95
msgid "e.g. 10s, 1min, 1h, 1D, 1W, 1MS (month start)"
msgstr "z. B. 10s, 1min, 1h, 1D, 1W, 1MS (Monatsanfang)"

#: datacook/engine/ops/timeseries.py:100
msgid "Resample"
msgstr "Resamplen"

#: datacook/engine/ops/timeseries.py:102
msgid ""
"Aggregate the rows per time interval (e.g. mean per minute), optionally per "
"group."
msgstr ""
"Die Zeilen pro Zeitintervall aggregieren (z. B. Mittelwert pro Minute), "
"optional pro Gruppe."

#: datacook/engine/ops/timeseries.py:109 datacook/engine/ops/timeseries.py:242
msgid "Interval"
msgstr "Intervall"

#: datacook/engine/ops/timeseries.py:112
msgid "Per group of"
msgstr "Pro Gruppe von"

#: datacook/engine/ops/timeseries.py:114
msgid "Closed side"
msgstr "Geschlossene Seite"

#: datacook/engine/ops/timeseries.py:115
msgid "Label side"
msgstr "Beschriftete Seite"

#: datacook/engine/ops/timeseries.py:232
msgid "Upsample"
msgstr "Hochtasten (Upsample)"

#: datacook/engine/ops/timeseries.py:234
msgid ""
"One row per time interval (finer than the data): new rows are filled "
"forward, backward, from the nearest row, interpolated or left missing."
msgstr ""
"Eine Zeile pro Zeitintervall (feiner als die Daten): neue Zeilen werden "
"vorwärts, rückwärts, aus der nächsten Zeile oder interpoliert gefüllt oder "
"bleiben leer."

#: datacook/engine/ops/timeseries.py:244
msgid "Fill new rows"
msgstr "Neue Zeilen füllen"

#: datacook/engine/ops/timeseries.py:316
msgid "Seconds since start"
msgstr "Sekunden seit Beginn"

#: datacook/engine/ops/timeseries.py:317
msgid "New column: seconds since the earliest time (e.g. for x axes of plots)."
msgstr ""
"Neue Spalte: Sekunden seit der frühesten Zeit (z. B. für x-Achsen von "
"Diagrammen)."

#: datacook/engine/ops/timeseries.py:357
msgid "Number segments between gaps"
msgstr "Abschnitte zwischen Lücken nummerieren"

#: datacook/engine/ops/timeseries.py:359
msgid ""
"New column numbering the segments of the data (1, 2, ...): a new segment "
"starts where the time (or a numeric column) jumps by more than the maximum "
"gap."
msgstr ""
"Neue Spalte, die die Abschnitte der Daten nummeriert (1, 2, ...): ein neuer "
"Abschnitt beginnt, wo die Zeit (oder eine numerische Spalte) um mehr als die "
"maximale Lücke springt."

#: datacook/engine/ops/timeseries.py:369
msgid "Maximum gap"
msgstr "Maximale Lücke"

#: datacook/engine/ops/timeseries.py:370
msgid "A duration (e.g. 1s, 5min) for date / time, a number otherwise."
msgstr "Eine Dauer (z. B. 1s, 5min) für Datum / Zeit, sonst eine Zahl."

#: datacook/engine/ops/timeseries.py:436 datacook/engine/ops/timeseries.py:619
msgid "Window"
msgstr "Fenster"

#: datacook/engine/ops/timeseries.py:437 datacook/engine/ops/timeseries.py:620
msgid "Number of rows, or a duration like 10s / 5min (needs a time column)."
msgstr ""
"Anzahl Zeilen oder eine Dauer wie 10s / 5min (braucht eine Zeitspalte)."

#: datacook/engine/ops/timeseries.py:444
msgid "Fewer values give a missing result."
msgstr "Weniger Werte ergeben ein fehlendes Ergebnis."

#: datacook/engine/ops/timeseries.py:446
msgid "Centered window"
msgstr "Zentriertes Fenster"

#: datacook/engine/ops/timeseries.py:458
msgid "Rolling window"
msgstr "Gleitendes Fenster"

#: datacook/engine/ops/timeseries.py:460
msgid ""
"Moving mean, sum, minimum, ... over a window of rows or of a duration "
"(smoothing)."
msgstr ""
"Gleitender Mittelwert, Summe, Minimum, ... über ein Fenster aus Zeilen oder "
"einer Dauer (Glättung)."

#: datacook/engine/ops/timeseries.py:524
msgid "Cumulative (expanding window)"
msgstr "Kumulativ (wachsendes Fenster)"

#: datacook/engine/ops/timeseries.py:525
msgid ""
"Mean, sum, minimum, ... of all values from the first row up to each row."
msgstr ""
"Mittelwert, Summe, Minimum, ... aller Werte von der ersten bis zur "
"jeweiligen Zeile."

#: datacook/engine/ops/timeseries.py:566
msgid "Shift values"
msgstr "Werte verschieben"

#: datacook/engine/ops/timeseries.py:567
msgid "Move values down (positive periods) or up (negative) by rows."
msgstr ""
"Werte um Zeilen nach unten (positive Perioden) oder oben (negative) "
"verschieben."

#: datacook/engine/ops/timeseries.py:574
msgid "Value for new cells"
msgstr "Wert für neue Zellen"

#: datacook/engine/ops/timeseries.py:579
msgid "Difference"
msgstr "Differenz"

#: datacook/engine/ops/timeseries.py:580
msgid "Difference to the value n rows before."
msgstr "Differenz zum Wert n Zeilen davor."

#: datacook/engine/ops/timeseries.py:591
msgid "Relative change"
msgstr "Relative Änderung"

#: datacook/engine/ops/timeseries.py:592
msgid "Relative change to the value n rows before (0.1 = +10 %)."
msgstr "Relative Änderung zum Wert n Zeilen davor (0.1 = +10 %)."

#: datacook/engine/ops/timeseries.py:605
msgid "Tolerance bands"
msgstr "Toleranzbänder"

#: datacook/engine/ops/timeseries.py:607
msgid ""
"New columns <column>_lower / _upper: the centered rolling minimum / maximum, "
"at least the given fraction below / above each value."
msgstr ""
"Neue Spalten <Spalte>_lower / _upper: das zentrierte gleitende Minimum / "
"Maximum, mindestens um den angegebenen Anteil unter / über jedem Wert."

#: datacook/engine/ops/timeseries.py:622
msgid "Minimum distance (fraction)"
msgstr "Mindestabstand (Anteil)"

#: datacook/engine/ops/values.py:26
msgid "Absolute values"
msgstr "Absolutwerte"

#: datacook/engine/ops/values.py:27
msgid "Replace numbers by their absolute value."
msgstr "Zahlen durch ihren Absolutwert ersetzen."

#: datacook/engine/ops/values.py:41
msgid "Clip values"
msgstr "Werte begrenzen"

#: datacook/engine/ops/values.py:43
msgid ""
"Limit numbers to a range: values below the lower bound become the lower "
"bound, values above the upper bound become the upper bound."
msgstr ""
"Zahlen auf einen Bereich begrenzen: Werte unter der Untergrenze werden zur "
"Untergrenze, Werte über der Obergrenze zur Obergrenze."

#: datacook/engine/ops/values.py:55
msgid "Lower bound"
msgstr "Untergrenze"

#: datacook/engine/ops/values.py:56
msgid "Upper bound"
msgstr "Obergrenze"

#: datacook/engine/ops/values.py:73
msgid "Replace values"
msgstr "Werte ersetzen"

#: datacook/engine/ops/values.py:75
msgid ""
"Replace values (in all or some columns) by a new value, or mark them as "
"missing."
msgstr ""
"Werte (in allen oder einigen Spalten) durch einen neuen Wert ersetzen oder "
"als fehlend markieren."

#: datacook/engine/ops/values.py:82
msgid "New value (empty: missing)"
msgstr "Neuer Wert (leer: fehlend)"

#: datacook/engine/recipes.py:115
msgid "A recipe needs at least one step."
msgstr "Ein Rezept braucht mindestens einen Schritt."

#: datacook/engine/recipes.py:120
msgid "Step {index}: unknown operation {op!r}"
msgstr "Schritt {index}: unbekannte Operation {op!r}"

#: datacook/engine/recipes.py:123
#, python-brace-format
msgid "Step {index}: {op} takes {n} input(s)"
msgstr "Schritt {index}: {op} erwartet {n} Eingabe(n)"

#: datacook/engine/recipes.py:127
msgid "Step {index}: invalid input {ref!r}"
msgstr "Schritt {index}: ungültige Eingabe {ref!r}"

#: datacook/engine/recipes.py:163
msgid "Not a DataCook recipe"
msgstr "Kein DataCook-Rezept"

#: datacook/engine/recipes.py:166
msgid "Unsupported recipe version {version!r} (supported: up to {supported})"
msgstr ""
"Nicht unterstützte Rezeptversion {version!r} (unterstützt: bis {supported})"

#: datacook/engine/recipes.py:173
#, python-brace-format
msgid "Step {index}: {error}"
msgstr "Schritt {index}: {error}"

#: datacook/engine/recipes.py:199
#, python-brace-format
msgid "Not a DataCook recipe: {error}"
msgstr "Kein DataCook-Rezept: {error}"

#: datacook/engine/recipes.py:246
msgid "No steps selected for the recipe."
msgstr "Keine Schritte für das Rezept ausgewählt."

#: datacook/engine/recipes.py:251
#, python-brace-format
msgid ""
"The steps use {n} steps outside the selection as input; a recipe can have "
"only one input."
msgstr ""
"Die Schritte verwenden {n} Schritte außerhalb der Auswahl als Eingabe; ein "
"Rezept kann nur eine Eingabe haben."

#: datacook/engine/recipes.py:307
msgid "The start step is not on the path to the step."
msgstr "Der Startschritt liegt nicht auf dem Weg zu diesem Schritt."

#: datacook/engine/recipes.py:325
msgid "The first recipe must end in a single step to merge."
msgstr "Das erste Rezept muss zum Vereinen in einem einzigen Schritt enden."

#: datacook/engine/recipes.py:327
msgid "An import recipe can only be the first one of a merge."
msgstr "Ein Import-Rezept kann beim Vereinen nur das erste sein."

#: datacook/engine/recipes.py:375
msgid ""
"{name!r} is an import recipe (it starts with a reader): apply it to files."
msgstr ""
"{name!r} ist ein Import-Rezept (es beginnt mit einem Dateileser): auf "
"Dateien anwenden."

#: datacook/engine/recipes.py:378
msgid "{name!r} needs a step to apply it to."
msgstr "{name!r} braucht einen Schritt, auf den es angewendet wird."

#: datacook/engine/recipes.py:402
msgid "Only an import recipe with one reader can be applied to files."
msgstr ""
"Nur ein Import-Rezept mit genau einem Dateileser kann auf Dateien angewendet "
"werden."

#: datacook/engine/recipes.py:407
msgid "The recipe's first step does not read a file."
msgstr "Der erste Schritt des Rezepts liest keine Datei."

#: datacook/engine/recipes.py:438
msgid "Recipe {name!r} needs columns that {target} does not have: {columns}"
msgstr "Rezept {name!r} braucht Spalten, die {target} nicht hat: {columns}"

#: datacook/engine/recipes.py:439
msgid "the step"
msgstr "der Schritt"

#: datacook/engine/recipes.py:555
msgid "A recipe needs a name."
msgstr "Ein Rezept braucht einen Namen."

#: datacook/engine/recipes.py:574
msgid "Select at least two recipes to merge."
msgstr "Mindestens zwei Rezepte zum Vereinen auswählen."

#: datacook/engine/restructure.py:46
msgid ""
"The first step of a chain (a data source) cannot be deleted on its own. "
"Delete the step with its following steps instead."
msgstr ""
"Der erste Schritt einer Kette (eine Datenquelle) kann nicht allein gelöscht "
"werden. Stattdessen den Schritt mit seinen folgenden Schritten löschen."

#: datacook/engine/restructure.py:52
msgid ""
"A step with several inputs (e.g. a merge) cannot be deleted while keeping "
"its following steps: they would not know which input to use."
msgstr ""
"Ein Schritt mit mehreren Eingaben (z. B. ein Zusammenführen) kann nicht "
"unter Beibehaltung der folgenden Schritte gelöscht werden: sie wüssten "
"nicht, welche Eingabe sie verwenden sollen."

#: datacook/engine/restructure.py:68
#, python-brace-format
msgid ""
"The following steps use columns the previous step does not have: {columns}"
msgstr ""
"Die folgenden Schritte verwenden Spalten, die der vorherige Schritt nicht "
"hat: {columns}"

